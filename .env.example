# Copy to .env for local overrides. Nothing here is secret.

# Make draft products purchasable in a production build (used for QA of the cart flow).
# Never set this on the real deployment.
PUBLIC_ALLOW_DRAFTS=false

# --- Reserved for the checkout provider decision (see src/lib/commerce/index.ts) ---
# Stripe:  STRIPE_SECRET_KEY (server only, Cloudflare Pages Function) + STRIPE_WEBHOOK_SECRET
# Shopify: PUBLIC_SHOPIFY_STORE_DOMAIN + PUBLIC_SHOPIFY_STOREFRONT_TOKEN (public, browser)
