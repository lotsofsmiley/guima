---
import { Image, getImage } from 'astro:assets';
import { ShoppingBag } from 'lucide-astro';
import { products } from '../data/products';
import { formatPrice } from '../lib/format';

// In dev the draft products are purchasable so the cart flow can be exercised.
const canBuyDrafts = import.meta.env.DEV || import.meta.env.PUBLIC_ALLOW_DRAFTS === 'true';
const thumbs = await Promise.all(products.map((p) => getImage({ src: p.image, width: 160, height: 160, format: 'webp' })));
---

<section id="loja" class="section rule bg-ink-950">
  <div class="wrap">
    <div class="reveal flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="eyebrow mb-4">Loja oficial</p>
        <h2 class="text-headline uppercase text-cream-100"><span class="sw">L</span>OJA</h2>
      </div>
      <p class="max-w-sm text-cream-500 text-pretty">Merch oficial, enviado do Porto. Preços com IVA incluído; portes calculados no checkout.</p>
    </div>

    <ul class="reveal mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {products.map((p, i) => {
        const buyable = !p.draft || canBuyDrafts;
        return (
          <li
            class="product group flex flex-col border border-ink-700 bg-ink-900 transition-colors hover:border-ink-600"
            data-product-id={p.id}
            data-title={p.title}
            data-price={p.priceCents}
            data-image={thumbs[i].src}
          >
            <div class="relative aspect-square overflow-hidden bg-ink-800">
              <Image
                src={p.image}
                alt={p.title}
                widths={[400, 600, 900]}
                sizes="(min-width: 64rem) 30vw, (min-width: 40rem) 45vw, 90vw"
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:scale-[1.03]"
              />
              {p.draft && (
                <span class="absolute left-3 top-3 bg-ink-950/80 px-2.5 py-1 text-xs uppercase tracking-[0.16em] text-buff-300">Em breve</span>
              )}
            </div>

            <div class="flex flex-1 flex-col gap-3 p-5">
              <div class="flex items-baseline justify-between gap-4">
                <h3 class="text-xl font-medium uppercase tracking-wide text-cream-100">{p.title}</h3>
                <p class="tabular text-lg text-sky-400">{formatPrice(p.priceCents)}</p>
              </div>
              <p class="text-sm text-cream-500">{p.description}</p>

              {p.variants.length > 1 ? (
                <fieldset class="mt-1">
                  <legend class="mb-2 text-xs uppercase tracking-[0.16em] text-cream-500">Tamanho</legend>
                  <div class="flex flex-wrap gap-2">
                    {p.variants.map((v, j) => (
                      <label class="variant">
                        <input type="radio" name={`variant-${p.id}`} value={v.id} data-label={v.label} checked={j === 0} class="sr-only" />
                        <span>{v.label}</span>
                      </label>
                    ))}
                  </div>
                </fieldset>
              ) : (
                <input type="hidden" name={`variant-${p.id}`} value={p.variants[0].id} data-label={p.variants[0].label} checked />
              )}

              <button class="btn btn--sky mt-auto w-full" type="button" data-add-to-cart disabled={!buyable}>
                <ShoppingBag size={16} stroke-width={2} />
                {buyable ? 'Adicionar ao carrinho' : 'Em breve'}
              </button>
            </div>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .variant span {
    display: inline-grid; place-items: center; min-width: 2.75rem; height: 2.5rem; padding-inline: 0.75rem;
    border: 1px solid var(--color-ink-600); color: var(--color-cream-300); font-size: 0.875rem; letter-spacing: 0.08em;
    cursor: pointer; transition: border-color 0.15s, color 0.15s, background-color 0.15s;
  }
  .variant:hover span { border-color: var(--color-cream-300); }
  .variant input:checked + span { border-color: var(--color-sky-400); color: var(--color-ink-950); background: var(--color-sky-400); }
  .variant input:focus-visible + span { outline: 2px solid var(--color-sky-400); outline-offset: 2px; }
</style>

<script>
  import { addToCart } from '../stores/cart';

  document.querySelectorAll<HTMLElement>('.product').forEach((card) => {
    const btn = card.querySelector<HTMLButtonElement>('[data-add-to-cart]')!;
    btn.addEventListener('click', () => {
      const picked =
        card.querySelector<HTMLInputElement>('input[type=radio]:checked') ??
        card.querySelector<HTMLInputElement>('input[type=hidden]');
      if (!picked) return;
      addToCart({
        variantId: picked.value,
        productId: card.dataset.productId!,
        title: card.dataset.title!,
        variantLabel: picked.dataset.label!,
        priceCents: Number(card.dataset.price),
        image: card.dataset.image!,
      });
    });
  });
</script>
