---
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ChevronLeft, ChevronRight, X } from 'lucide-astro';

/**
 * Every JPEG dropped into src/assets/gallery/ appears here — no HTML to touch.
 * The grid decides spans from each photo's real aspect ratio instead of v1's
 * hard-coded nth-of-type rules that broke whenever a photo was swapped.
 */
const modules = import.meta.glob<{ default: ImageMetadata }>('../assets/gallery/*.jpg', { eager: true });
const photos = Object.entries(modules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, m]) => m.default);

const spanFor = (img: ImageMetadata) => {
  const r = img.width / img.height;
  if (r < 0.85) return 'row-span-2'; // portrait → tall cell
  if (r > 1.45) return 'md:col-span-2'; // wide → double cell on tablet+
  return '';
};

// Large versions for the lightbox (generated at build, only fetched on click)
const large = await Promise.all(photos.map((p) => getImage({ src: p, width: 1800, format: 'webp', quality: 82 })));
---

<section id="galeria" class="section rule bg-ink-900">
  <div class="wrap">
    <div class="reveal flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="eyebrow mb-4">Galeria</p>
        <h2 class="text-headline uppercase text-cream-100"><span class="sw">G</span>ALERIA</h2>
      </div>
      <p class="max-w-sm text-cream-500 text-pretty">Palcos, ruas e bastidores. Carrega numa fotografia para a ver em grande.</p>
    </div>

    <ul class="reveal mt-10 grid grid-flow-dense auto-rows-[200px] grid-cols-2 gap-2 sm:auto-rows-[240px] md:grid-cols-3 md:gap-3 lg:grid-cols-4" id="gallery-grid">
      {photos.map((p, i) => (
        <li class:list={['relative overflow-hidden bg-ink-800', spanFor(p)]}>
          <button
            class="group block h-full w-full cursor-zoom-in"
            type="button"
            data-lightbox={i}
            data-large={large[i].src}
            aria-label={`Ver fotografia ${i + 1} em grande`}
          >
            <Picture
              src={p}
              alt={`GUIMA — fotografia ${i + 1}`}
              formats={['avif', 'webp']}
              widths={[360, 540, 800, 1100]}
              sizes="(min-width: 64rem) 25vw, (min-width: 48rem) 33vw, 50vw"
              loading="lazy"
              class="h-full w-full object-cover transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:scale-[1.04]"
            />
          </button>
        </li>
      ))}
    </ul>
  </div>

  <dialog id="lightbox" class="m-0 h-dvh max-h-none w-full max-w-none bg-ink-950/95 p-0 text-cream-100 backdrop:bg-ink-950/90" aria-label="Fotografia">
    <div class="relative flex h-full items-center justify-center">
      <img class="max-h-[92vh] max-w-[94vw] object-contain" alt="" data-lightbox-img />
      <button class="icon-btn absolute right-3 top-3 bg-ink-900/70" type="button" data-lb-close aria-label="Fechar"><X size={26} /></button>
      <button class="icon-btn absolute left-2 top-1/2 -translate-y-1/2 bg-ink-900/70" type="button" data-lb-prev aria-label="Anterior"><ChevronLeft size={28} /></button>
      <button class="icon-btn absolute right-2 top-1/2 -translate-y-1/2 bg-ink-900/70" type="button" data-lb-next aria-label="Seguinte"><ChevronRight size={28} /></button>
    </div>
  </dialog>
</section>

<style>
  #gallery-grid :global(picture) { display: block; height: 100%; }
  #gallery-grid :global(img) { height: 100% !important; }
  dialog[open] { display: block; }
  dialog { display: none; }
</style>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement;
  const img = dialog.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-lightbox]'));
  const sources = buttons.map((b) => b.dataset.large!);
  let i = 0;
  const show = (n: number) => {
    i = (n + sources.length) % sources.length;
    img.src = sources[i];
    img.alt = `GUIMA — fotografia ${i + 1}`;
  };
  buttons.forEach((b, n) => b.addEventListener('click', () => { show(n); dialog.showModal(); }));
  dialog.querySelector('[data-lb-close]')!.addEventListener('click', () => dialog.close());
  dialog.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(i - 1));
  dialog.querySelector('[data-lb-next]')!.addEventListener('click', () => show(i + 1));
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') show(i + 1);
    if (e.key === 'ArrowLeft') show(i - 1);
  });
</script>
