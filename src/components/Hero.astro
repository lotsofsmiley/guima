---
import { Picture } from 'astro:assets';
import { ChevronDown, Play } from 'lucide-astro';
import hero from '../assets/hero/hero-nova-era.jpg';
import { album } from '../data/album';
import { formatDate } from '../lib/format';
---

<section id="topo" class="relative flex min-h-svh items-end overflow-hidden bg-ink-950" aria-label="Nova Era">
  <div class="hero-media absolute inset-0" aria-hidden="true">
    <Picture
      src={hero}
      alt=""
      formats={['avif', 'webp']}
      widths={[640, 960, 1440, 2000, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      quality={78}
    />
    <!-- Scrim: keeps the title legible on any crop without the black box of v1 -->
    <div class="absolute inset-0 bg-gradient-to-t from-ink-950 via-ink-950/35 to-ink-950/10"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-ink-950/60 via-transparent to-transparent"></div>
  </div>

  <div class="wrap relative pb-20 pt-40 md:pb-28">
    <p class="eyebrow mb-4">Álbum de estreia · {formatDate(album.releaseDate)}</p>
    <h1 class="text-display uppercase text-cream-100 text-balance">
      <span class="sw">“</span><span class="sw">N</span>OVA <span class="sw">E</span>RA<span class="sw">”</span>
    </h1>
    <p class="mt-5 max-w-xl text-lead text-cream-300 text-pretty">
      Treze faixas para conquistar a cidade e escrever o nome nela. Produção de Vilas Boas. Do Porto para o mundo.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <button class="btn btn--solid" type="button" data-play-album>
        <Play size={16} stroke-width={2.25} /> Ouvir agora
      </button>
      <a class="btn" href="#loja">Comprar o CD</a>
    </div>
  </div>

  <a
    href="#sobre"
    class="absolute bottom-6 left-1/2 hidden -translate-x-1/2 text-cream-500 transition-colors hover:text-cream-100 md:block"
    aria-label="Ir para a secção Sobre"
  >
    <ChevronDown size={28} stroke-width={1.5} class="animate-bounce" />
  </a>
</section>

<style>
  .hero-media :global(picture),
  .hero-media :global(img) {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover;
    object-position: 62% 28%;
  }
  @media (min-width: 48rem) {
    .hero-media :global(img) { object-position: 50% 30%; }
  }
</style>
