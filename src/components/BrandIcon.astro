---
/**
 * Brand glyphs (Instagram, Spotify, …) from simple-icons — inlined SVG paths,
 * no icon-font, no third-party script. Lucide covers the UI icons; it has no brands.
 */
import { siInstagram, siSpotify, siApplemusic, siYoutube } from 'simple-icons';

interface Props {
  name: 'instagram' | 'spotify' | 'applemusic' | 'youtube';
  size?: number;
  class?: string;
}

const icons = { instagram: siInstagram, spotify: siSpotify, applemusic: siApplemusic, youtube: siYoutube };
const { name, size = 20, class: className } = Astro.props;
const icon = icons[name];
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
  <path d={icon.path}></path>
</svg>
