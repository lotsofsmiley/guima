---
/**
 * The wordmark. The M is the brand's swap letter — written once, here, instead of
 * twelve hand-typed copies. Kept on one line: Astro 7 strips JSX-style whitespace
 * between inline tags on separate lines, which would eat the spacing.
 */
interface Props {
  class?: string;
  /** Render as a link to the top of the page */
  href?: string;
}
const { class: className = '', href } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag
  href={href}
  class:list={['wordmark font-display font-normal uppercase tracking-[0.08em] text-sky-400 no-underline', className]}
  aria-label={href ? 'GUIMA — início' : undefined}
>GUI<span class="sw">M</span>A</Tag>
