---
import { Menu, X, ShoppingBag } from 'lucide-astro';
import Wordmark from './Wordmark.astro';
import BrandIcon from './BrandIcon.astro';
import { nav, socials } from '../data/site';
import { swapHtml } from '../lib/format';

/** Nav labels carry the swap letter too ("Nova Era" → "|N|ova Era"). */
const labelHtml = (label: string, swap?: number) =>
  swap === undefined
    ? label
    : swapHtml(label.slice(0, swap) + '|' + label[swap] + '|' + label.slice(swap + 1));
---

<header id="site-nav" class="fixed inset-x-0 top-0 z-40 h-nav transition-colors duration-300" data-scrolled="false">
  <div class="wrap flex h-full items-center justify-between gap-6">
    <Wordmark href="#topo" class="text-[1.75rem] leading-none" />

    <nav aria-label="Secções" class="hidden md:block">
      <ul class="flex items-center gap-7">
        {nav.map((item) => (
          <li>
            <a class="nav-link" href={item.href} data-nav-link set:html={labelHtml(item.label, item.swap)} />
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-1">
      <ul class="hidden items-center gap-1 lg:flex" aria-label="Redes sociais">
        {socials.map((s) => (
          <li>
            <a class="icon-btn text-buff-400 hover:text-buff-300" href={s.href} target="_blank" rel="noopener" aria-label={s.label}>
              <BrandIcon name={s.id} size={18} />
            </a>
          </li>
        ))}
      </ul>

      <button class="icon-btn relative" type="button" data-cart-toggle aria-label="Abrir carrinho">
        <ShoppingBag size={22} stroke-width={1.75} />
        <span
          class="absolute -top-0.5 -right-0.5 hidden min-w-5 rounded-full bg-sky-400 px-1 text-center text-[0.7rem] font-semibold leading-5 text-ink-950 tabular"
          data-cart-count
          aria-live="polite"
        ></span>
      </button>

      <button
        class="icon-btn md:hidden"
        type="button"
        data-menu-open
        aria-label="Abrir menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <Menu size={24} stroke-width={1.75} />
      </button>
    </div>
  </div>

  <!-- Mobile menu: a native <dialog> gives focus trapping and Esc-to-close for free. -->
  <dialog id="mobile-menu" class="m-0 h-dvh max-h-none w-full max-w-none bg-ink-950 p-0 text-cream-100 backdrop:bg-ink-950/80" aria-label="Menu">
    <div class="flex h-full flex-col">
      <div class="wrap flex h-nav items-center justify-between">
        <Wordmark class="text-[1.75rem] leading-none" />
        <button class="icon-btn" type="button" data-menu-close aria-label="Fechar menu">
          <X size={26} stroke-width={1.75} />
        </button>
      </div>
      <nav class="wrap flex flex-1 flex-col justify-center" aria-label="Secções">
        <ul class="flex flex-col gap-2">
          {nav.map((item) => (
            <li>
              <a
                class="block py-2 text-[2.5rem] font-medium uppercase leading-none tracking-[0.06em]"
                href={item.href}
                data-nav-link
                data-menu-link
                set:html={labelHtml(item.label, item.swap)}
              />
            </li>
          ))}
        </ul>
      </nav>
      <div class="wrap rule flex items-center justify-around py-6">
        {socials.map((s) => (
          <a class="icon-btn text-buff-400" href={s.href} target="_blank" rel="noopener" aria-label={s.label}>
            <BrandIcon name={s.id} size={24} />
          </a>
        ))}
      </div>
    </div>
  </dialog>
</header>

<style>
  #site-nav[data-scrolled='true'] {
    background: color-mix(in oklab, var(--color-ink-900) 82%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 1px 0 color-mix(in oklab, var(--color-cream-100) 8%, transparent);
  }
  dialog[open] { display: block; }
  dialog { display: none; }
  /* Same underline reveal for the big mobile links */
  [data-menu-link][aria-current='true'] { color: var(--color-sky-400); }
</style>

<script>
  import { cartOpen, cartCount } from '../stores/cart';

  const header = document.getElementById('site-nav')!;
  const dialog = document.getElementById('mobile-menu') as HTMLDialogElement;
  const openBtn = header.querySelector<HTMLButtonElement>('[data-menu-open]')!;

  // --- solid background once the hero is scrolled past the top edge
  const onScroll = () => header.dataset.scrolled = String(window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // --- mobile menu
  const openMenu = () => { dialog.showModal(); openBtn.setAttribute('aria-expanded', 'true'); document.body.style.overflow = 'hidden'; };
  const closeMenu = () => { dialog.close(); };
  dialog.addEventListener('close', () => { openBtn.setAttribute('aria-expanded', 'false'); document.body.style.overflow = ''; });
  openBtn.addEventListener('click', openMenu);
  header.querySelector('[data-menu-close]')!.addEventListener('click', closeMenu);
  dialog.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', closeMenu));
  // click on the backdrop (outside the panel) closes too
  dialog.addEventListener('click', (e) => { if (e.target === dialog) closeMenu(); });

  // --- cart button + badge
  header.querySelector('[data-cart-toggle]')!.addEventListener('click', () => cartOpen.set(true));
  const badge = header.querySelector<HTMLElement>('[data-cart-count]')!;
  cartCount.subscribe((n) => {
    badge.textContent = n > 99 ? '99+' : String(n);
    badge.classList.toggle('hidden', n === 0);
  });

  // --- active section: the section crossing the vertical middle of the viewport wins.
  // (A threshold-based observer never fires on sections taller than 1/threshold viewports.)
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'));
  const targets = links
    .map((a) => document.querySelector<HTMLElement>(a.getAttribute('href')!))
    .filter((el): el is HTMLElement => el !== null);
  const setActive = (id: string | null) =>
    links.forEach((a) => {
      const on = id !== null && a.getAttribute('href') === `#${id}`;
      if (on) a.setAttribute('aria-current', 'true'); else a.removeAttribute('aria-current');
    });
  const io = new IntersectionObserver(
    (entries) => {
      const hit = entries.find((e) => e.isIntersecting);
      if (hit) setActive(hit.target.id);
      else if (window.scrollY < window.innerHeight * 0.5) setActive(null);
    },
    { rootMargin: '-45% 0px -50% 0px', threshold: 0 },
  );
  new Set(targets).forEach((t) => io.observe(t));
</script>
