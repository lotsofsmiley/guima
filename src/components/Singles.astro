---
import { Image, getImage } from 'astro:assets';
import { faPlay, faXmark } from '@fortawesome/free-solid-svg-icons';
import Icon from './Icon.astro';
import { releases, yearOf, typeLabel, coverOf } from '../data/discography';
import { brandIcons } from '../lib/icons';
import type { PlayableTrack } from '../stores/player';

/**
 *   - releases with a Spotify id → play in the bottom dock (same player as the album)
 *   - YouTube-only videos        → open in a modal; the iframe is only created on click
 */
const thumbs = await Promise.all(releases.map((r) => getImage({ src: coverOf(r), width: 128, height: 128, format: 'webp' })));

const queue: PlayableTrack[] = releases
  .map((r, i) => ({ r, cover: thumbs[i].src }))
  .filter(({ r }) => r.audio || r.playSpotifyId || r.spotifyId)
  .map(({ r, cover }) => ({
    id: `rel-${r.id}`,
    title: r.title,
    artists: r.artists,
    cover,
    audio: r.audio,
    spotifyId: r.playSpotifyId ?? r.spotifyId,
    youtubeId: r.youtubeId,
    links: {
      spotify: r.spotifyUrl,
      youtube: r.youtubeId ? `https://www.youtube.com/watch?v=${r.youtubeId}` : undefined,
      apple: r.appleUrl,
    },
  }));
const queueJson = JSON.stringify(queue).replace(/</g, '\\u003c');
---

{releases.length > 0 && (
  <section id="singles" class="section rule bg-ink-900">
    <div class="wrap">
      <div class="reveal">
        <p class="eyebrow mb-4">Discografia</p>
        <h2 class="text-headline uppercase text-cream-100">
          <span class="sw">S</span>INGLES <span class="mx-1 align-middle text-[0.4em] text-cream-500/40">&amp;</span> <span class="sw">F</span>REESTYLES
        </h2>
      </div>

      <ul class="reveal mt-12 flex snap-x snap-mandatory gap-5 overflow-x-auto pb-4 md:grid md:grid-cols-2 md:gap-8 md:overflow-visible lg:grid-cols-4" id="singles-list">
        {releases.map((r) => {
          const viaSpotify = Boolean(r.audio || r.playSpotifyId || r.spotifyId); // plays in the dock
          const viaVideo = !viaSpotify && Boolean(r.youtubeId);
          const isVideo = r.type === 'video' || r.type === 'live';
          const links = [
            r.spotifyUrl && { id: 'spotify' as const, href: r.spotifyUrl, label: 'Spotify' },
            r.youtubeId && { id: 'youtube' as const, href: `https://www.youtube.com/watch?v=${r.youtubeId}`, label: 'YouTube' },
            r.appleUrl && { id: 'applemusic' as const, href: r.appleUrl, label: 'Apple Music' },
          ].filter((l): l is { id: 'spotify' | 'youtube' | 'applemusic'; href: string; label: string } => Boolean(l));
          return (
            <li class="release group w-[74vw] shrink-0 snap-start sm:w-[46vw] md:w-auto" data-release-id={`rel-${r.id}`}>
              <div class="relative aspect-square overflow-hidden bg-ink-800">
                <Image
                  src={coverOf(r)}
                  alt={`${isVideo ? 'Miniatura' : 'Capa'} de ${r.title}`}
                  widths={[400, 600, 800]}
                  sizes="(min-width: 64rem) 24vw, (min-width: 48rem) 45vw, 74vw"
                  loading="lazy"
                  class="release-cover h-full w-full object-cover transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:scale-[1.03]"
                />
                {(viaSpotify || viaVideo) && (
                  <button
                    class="release-play absolute inset-0 grid place-items-center bg-ink-950/0 transition-colors hover:bg-ink-950/40 focus-visible:bg-ink-950/40"
                    type="button"
                    data-play-release={viaSpotify ? `rel-${r.id}` : undefined}
                    data-play-video={viaVideo ? r.youtubeId : undefined}
                    data-video-title={viaVideo ? r.title : undefined}
                    aria-label={`${viaSpotify ? 'Reproduzir' : 'Ver o vídeo de'} ${r.title}`}
                  >
                    <span class="grid h-16 w-16 place-items-center rounded-full bg-cream-100 text-ink-950 opacity-0 shadow-lg transition-opacity group-hover:opacity-100 group-focus-within:opacity-100">
                      <Icon icon={faPlay} size={22} class="translate-x-0.5" />
                    </span>
                  </button>
                )}
                <span class="pointer-events-none absolute left-3 top-3 bg-ink-950/75 px-2 py-0.5 text-sm uppercase tracking-[0.18em] text-buff-300">
                  {typeLabel[r.type]}
                </span>
              </div>
              <div class="mt-3 flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <h3 class="truncate text-[1.6rem] uppercase leading-tight tracking-wide text-cream-100">{r.title}</h3>
                  <p class="truncate text-base uppercase tracking-[0.14em] text-cream-500">
                    {yearOf(r)}{r.artists.length > 1 && ` · ${r.artists.filter((a) => a !== 'GUIMA').join(', ')}`}
                  </p>
                </div>
                <ul class="flex shrink-0 gap-0.5 text-buff-400">
                  {links.map((l) => (
                    <li><a class="icon-btn h-10 w-10" href={l.href} target="_blank" rel="noopener" aria-label={l.label}><Icon icon={brandIcons[l.id]} size={20} /></a></li>
                  ))}
                </ul>
              </div>
            </li>
          );
        })}
      </ul>
    </div>

    <dialog id="video-modal" class="m-0 h-dvh max-h-none w-full max-w-none bg-ink-950/95 p-0 text-cream-100 backdrop:bg-ink-950/90" aria-label="Vídeo">
      <div class="relative flex h-full items-center justify-center p-4">
        <div class="aspect-video w-full max-w-6xl bg-ink-900" data-video-frame></div>
        <button class="icon-btn absolute right-3 top-3 bg-ink-900/70" type="button" data-video-close aria-label="Fechar vídeo"><Icon icon={faXmark} size={30} /></button>
      </div>
    </dialog>

    <script is:inline type="application/json" id="singles-queue" set:html={queueJson} />
  </section>
)}

<style>
  #singles-list { scrollbar-width: none; }
  #singles-list::-webkit-scrollbar { display: none; }
  #singles-list :global(img.release-cover) { height: 100% !important; }
  .release.is-current h3 { color: var(--color-sky-300); }
  .release.is-current .release-play > span { opacity: 1; }
  dialog[open] { display: block; }
  dialog { display: none; }
</style>

<script>
  import { playTrack, currentTrack, intent, type PlayableTrack } from '../stores/player';

  const el = document.getElementById('singles-queue');
  if (el) {
    const queue: PlayableTrack[] = JSON.parse(el.textContent!);
    const byId = new Map(queue.map((t) => [t.id, t]));
    document.querySelectorAll<HTMLButtonElement>('[data-play-release]').forEach((btn) =>
      btn.addEventListener('click', () => playTrack(byId.get(btn.dataset.playRelease!)!, queue)),
    );
    const rows = Array.from(document.querySelectorAll<HTMLElement>('.release[data-release-id]'));
    currentTrack.subscribe((t) => rows.forEach((r) => r.classList.toggle('is-current', r.dataset.releaseId === t?.id)));

    const modal = document.getElementById('video-modal') as HTMLDialogElement;
    const frame = modal.querySelector<HTMLElement>('[data-video-frame]')!;
    const open = (id: string, title: string) => {
      intent.set('pause');
      frame.innerHTML = '';
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      iframe.title = title;
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.className = 'h-full w-full';
      iframe.setAttribute('allowfullscreen', '');
      frame.appendChild(iframe);
      modal.showModal();
    };
    const close = () => { modal.close(); };
    modal.addEventListener('close', () => { frame.innerHTML = ''; });
    document.querySelectorAll<HTMLButtonElement>('[data-play-video]').forEach((btn) =>
      btn.addEventListener('click', () => open(btn.dataset.playVideo!, btn.dataset.videoTitle ?? 'Vídeo')),
    );
    modal.querySelector('[data-video-close]')!.addEventListener('click', close);
    modal.addEventListener('click', (e) => { if (e.target === modal) close(); });
  }
</script>
