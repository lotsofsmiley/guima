---
import Base from './Base.astro';
import { ArrowLeft } from 'lucide-astro';
import { legal } from '../data/site';
import { formatDate } from '../lib/format';

interface Props {
  title: string;
  description: string;
  updated: string;
  path: string;
  showSeller?: boolean;
}
const { title, description, updated, path, showSeller = false } = Astro.props;
---

<Base title={`${title} — GUIMA`} description={description} path={path}>
  <article class="wrap pb-24 pt-32 md:pt-40">
    <a href="/" class="mb-8 inline-flex items-center gap-2 text-sm uppercase tracking-[0.14em] text-cream-500 hover:text-cream-100">
      <ArrowLeft size={16} /> Voltar ao site
    </a>
    <p class="eyebrow mb-3">Informação legal</p>
    <h1 class="text-headline uppercase text-cream-100">{title}</h1>
    <p class="mt-3 text-sm text-cream-500">Última atualização: {formatDate(updated)}</p>

    {showSeller && (
      <aside class="mt-8 border border-ink-700 bg-ink-800 p-5 text-sm" aria-label="Identificação do vendedor">
        <p class="eyebrow mb-2">Vendedor</p>
        <dl class="grid gap-1 sm:grid-cols-[auto_1fr] sm:gap-x-6">
          <dt class="text-cream-500">Nome</dt><dd class="text-cream-100">{legal.sellerName}</dd>
          <dt class="text-cream-500">NIF</dt><dd class="text-cream-100">{legal.nif}</dd>
          <dt class="text-cream-500">Morada</dt><dd class="text-cream-100">{legal.address}</dd>
          <dt class="text-cream-500">Email</dt><dd class="text-cream-100">{legal.email}</dd>
          {legal.phone && (<><dt class="text-cream-500">Telefone</dt><dd class="text-cream-100">{legal.phone}</dd></>)}
        </dl>
      </aside>
    )}

    <div class="legal-prose mt-10 max-w-prose">
      <slot />
    </div>
  </article>
</Base>

<style is:global>
  .legal-prose { color: var(--color-cream-300); font-size: 1.0625rem; line-height: 1.65; }
  .legal-prose h2 { margin-top: 2.5rem; margin-bottom: 0.75rem; font-size: 1.5rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-cream-100); }
  .legal-prose h3 { margin-top: 1.75rem; margin-bottom: 0.5rem; font-size: 1.15rem; font-weight: 500; color: var(--color-cream-100); }
  .legal-prose p { margin-block: 0.75rem; }
  .legal-prose ul, .legal-prose ol { margin-block: 0.75rem; padding-left: 1.25rem; }
  .legal-prose li { margin-block: 0.25rem; }
  .legal-prose ul { list-style: disc; }
  .legal-prose ol { list-style: decimal; }
  .legal-prose a { color: var(--color-sky-400); text-decoration: underline; text-underline-offset: 3px; }
  .legal-prose a:hover { color: var(--color-sky-300); }
  .legal-prose strong { color: var(--color-cream-100); font-weight: 500; }
  .legal-prose table { width: 100%; border-collapse: collapse; margin-block: 1rem; font-size: 0.95rem; }
  .legal-prose th, .legal-prose td { border: 1px solid var(--color-ink-700); padding: 0.5rem 0.75rem; text-align: left; vertical-align: top; }
  .legal-prose th { color: var(--color-cream-100); font-weight: 500; }
</style>
